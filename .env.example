# El puerto de desarrollo (4242) se define en nuxt.config.ts → devServer.port.
# No agregar PORT aquí: Nuxt/Vite lo usan como primer candidato para el WebSocket de HMR,
# que ocupa 127.0.0.1:4242 y hace que Firefox reciba "426 Upgrade Required".
# (En producción, PORT sí se define en el entorno del servidor que ejecuta .output/server/index.mjs)

# URL Base del Backend NestJS (incluye prefijo global /api/v1)
NUXT_PUBLIC_API_BASE=http://localhost:3000/api/v1

# Responsable del tratamiento de datos personales (Ley 1581 de 2012). Se publican en /data-policy.
# Obligatorios antes de desplegar: sin ellos la política no identifica al responsable.
NUXT_PUBLIC_DATA_CONTROLLER_NAME=
NUXT_PUBLIC_DATA_CONTROLLER_ID=
NUXT_PUBLIC_DATA_CONTROLLER_ADDRESS=
NUXT_PUBLIC_DATA_CONTROLLER_CITY=
NUXT_PUBLIC_DATA_CONTROLLER_EMAIL=
NUXT_PUBLIC_DATA_CONTROLLER_PHONE=
